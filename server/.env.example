# 复制本文件为 .env 后填入,不填则后端自动使用内置示例数据

# 高德开放平台 → 应用管理 → 添加 Key → 服务平台选「Web 服务」
# https://console.amap.com/dev/key/app
AMAP_KEY="请替换为高德 Key"

# 大模型。接口是 OpenAI 兼容格式,换供应商只需改下面三个变量。
# 默认阿里云百炼 / 通义千问:https://bailian.console.aliyun.com → 右上「密钥管理」
LLM_KEY="请替换为大模型 Key"
MODEL_NAME="qwen3.7-flash-2026-07-15"
MODEL_URL="https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions"

# 当下热点:生成行程前先让模型联网检索一趟,把限时展/新晋打卡地/重新走红的老景点捞回来,
# 再由高德核实真实存在才放进候选池。首次会慢 5~15 秒(结果缓存 6 小时)。
# 注意:不是每家供应商都支持联网(阿里百炼支持)。换供应商后若报错,设为 0 关掉即可。
HOTSPOTS="1"

# 腾讯地图底图(可选)。WorkBuddy 预览里打开不需要填,会走内置代理;
# 自己 uvicorn 起服务时要填:腾讯位置服务开放平台 → 应用管理 → 添加 Key
# https://lbs.qq.com/dev/console/application/mine
TMAP_KEY=""

# 天地图 Key(合规白名单内,用于真三维地形页的卫星底图)。免费申请:
# 天地图开放平台 → 应用管理 → 创建应用 → 复制 tk
# https://console.tianditu.gov.cn/api/key
# 留空则真三维地形页用 Esri 卫星兜底(境外图源,仅供个人可视化)。
TIANDITU_TK=""
